# Run node scripts/setup-env.mjs to generate .env, or supply a URL-safe DB password.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
# Optional Compose-only shortcut: host folder/drive mounted read-only at /music.
# Leave blank to start with empty Docker-managed storage; add host mounts later.
# Examples: /srv/music, C:/Users/Danny/Music, or D:/ to browse a whole drive.
# Multiple drives: see compose.storage.example.yaml, then choose folders in the UI.
MUSIC_PATH=
PUBLIC_URL=http://localhost:8080
# Opt in to accessing the app through any hostname; default restricts mutation origins.
ALLOW_ANY_ORIGIN=false
BIND_ADDRESS=127.0.0.1
PORT=8080
TRANSCODE_WORKERS=2
TRANSCODE_CACHE_MB=2048
SCAN_INTERVAL_MINUTES=60
# Required only for optional enrichment. Supply your project URL/contact.
METADATA_USER_AGENT=
