# Copy to .env; choose different strong secrets. Keep the DB password URL-safe.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
SETUP_TOKEN=replace-with-a-different-long-random-token
# Absolute host path. Windows Docker Desktop example: C:/Users/Danny/Music
MUSIC_PATH=/srv/music
PUBLIC_URL=http://localhost:8080
BIND_ADDRESS=127.0.0.1
PORT=8080
TRANSCODE_WORKERS=2
TRANSCODE_CACHE_MB=2048
SCAN_INTERVAL_MINUTES=60
# Required only for optional enrichment. Supply your project URL/contact.
METADATA_USER_AGENT=
