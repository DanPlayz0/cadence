# Run node scripts/setup-env.mjs to generate .env, or supply a URL-safe DB password.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
# Optional Compose-only shortcut: host folder/drive mounted read-only at /music.
# Leave blank to start with empty Docker-managed storage; add host mounts later.
# Examples: /srv/music, C:/Users/Danny/Music, or D:/ to browse a whole drive.
# Multiple drives: see compose.storage.example.yaml, then choose folders in the UI.
MUSIC_PATH=
PUBLIC_URL=http://localhost:8080
# Additional allowed origins, comma-separated (include schemes and non-default ports).
# Example: http://cadence.media.local,https://cadence.example.com
PUBLIC_URLS=
# Opt in to accessing the app through any hostname; default restricts mutation origins.
ALLOW_ANY_ORIGIN=false
BIND_ADDRESS=127.0.0.1
PORT=8080
TRANSCODE_WORKERS=2
TRANSCODE_CACHE_MB=2048
SCAN_INTERVAL_MINUTES=60
# Required only for optional enrichment. Supply your project URL/contact.
METADATA_USER_AGENT=

# Optional Last.fm defaults; prefer Instance settings → Sync in the web UI.
# Saved web settings override these values, including when Last.fm is disabled.
# Saved application credentials, user sessions, and tokens use DATA_DIR/sync.key; back up that key.
LASTFM_API_KEY=
LASTFM_API_SECRET=

# Optional Soulseek: see docs/SOULSEEK.md. Credentials stay server-side.
# External slskd base URL reachable from the app container (omit /api/v0).
# Leave blank when disabled or using compose.soulseek.yaml.
SLSKD_URL=
# External slskd completed-download folder on the Docker host, e.g. /srv/slskd/downloads.
# It must expose the same files as slskd's downloads directory, including batch subfolders.
# Leave blank for the bundled container's Docker-managed staging volume.
SOULSEEK_STAGING_PATH=
# Network credentials below are used only by the optional bundled container.
SOULSEEK_USERNAME=
SOULSEEK_PASSWORD=
SOULSEEK_PEER_PORT=50300
SLSKD_USERNAME=cadence
SLSKD_PASSWORD=replace-with-a-long-random-hex-password
SLSKD_API_KEY=replace-with-a-long-random-hex-api-key
# Container paths, separated by semicolons; destinations also need writable mounts.
SOULSEEK_WRITABLE_ROOTS=
