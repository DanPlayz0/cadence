# Run node scripts/setup-env.mjs to generate .env, or supply a URL-safe DB password.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
# Absolute host storage path mounted read-only at /music. A broad parent folder is fine.
# Choose subfolders and user/group sharing in Instance settings > Libraries.
# Windows Docker Desktop example: C:/Users/Danny/Music
MUSIC_PATH=/srv/music
PUBLIC_URL=http://localhost:8080
# Opt in to accessing the app through any hostname; default restricts mutation origins.
ALLOW_ANY_ORIGIN=false
BIND_ADDRESS=127.0.0.1
PORT=8080
TRANSCODE_WORKERS=2
TRANSCODE_CACHE_MB=2048
SCAN_INTERVAL_MINUTES=60
# Required only for optional enrichment. Supply your project URL/contact.
METADATA_USER_AGENT=
